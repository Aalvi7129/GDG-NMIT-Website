# Copy to .env.local (local) or set in your host's environment settings.

# MongoDB connection string (teams, events, contact form, admin-edited content)
MONGODB_URI=

# Cloudinary (team member photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Content admin panel at /admin. Leave empty to keep the panel switched off.
# ADMIN_PASSWORD: at least 14 characters, unique, shared only with content editors.
# ADMIN_SESSION_SECRET: at least 32 random characters, e.g. `openssl rand -base64 48`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
